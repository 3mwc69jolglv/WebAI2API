# Salin file ini menjadi `.env` dan isi nilainya.
# JANGAN commit `.env` ke git — cookie = kredensial penuh akunmu.

# Port server API (default: 8080)
AIW2A_PORT=8080

# Kunci API untuk melindungi AiWeb2API sendiri (opsional).
# Kalau diisi, client harus kirim header: Authorization: Bearer <kunci>
AIW2A_API_KEY=

# --- Kredensial provider (isi yang kamu butuhkan saja) ---

# ChatGPT: seluruh nilai header Cookie dari chatgpt.com
# (DevTools -> tab Application -> Cookies -> chatgpt.com)
AIW2A_CHATGPT_COOKIES=

# Claude: seluruh nilai header Cookie dari claude.ai (harus memuat sessionKey)
AIW2A_CLAUDE_COOKIES=

# Gemini: seluruh nilai header Cookie dari google.com
# (minimal memuat __Secure-1PSID)
AIW2A_GEMINI_COOKIES=

# Grok: cukup nilai cookie `sso` dari grok.com
AIW2A_GROK_SSO=

# Grok: URL signer `x-statsig-id` eksternal (mis. self-hosted, opsional).
# Default: generate lokal (tidak ada pihak ketiga); kosongkan ("") untuk menonaktifkan signing.
# AIW2A_GROK_STATSIG_SIGNER=

# --- Persistensi rotasi cookie (opsional, per provider) ---
# Bila diisi, rotasi cookie dari header Set-Cookie upstream ditulis ke file
# ini (chmod 600, format header Cookie) agar bertahan sampai restart.
# Tanpa ini, rotasi hanya bertahan in-memory. File ini TIDAK dibaca saat
# startup (startup selalu memakai cookie dari env di atas).
# AIW2A_CHATGPT_COOKIES_FILE=
# AIW2A_CLAUDE_COOKIES_FILE=
# AIW2A_GEMINI_COOKIES_FILE=
# AIW2A_GROK_COOKIES_FILE=
